{
  "name": "EcoMesh",
  "short_name": "EcoMesh",
  "description": "Peer-to-peer disaster-relief mesh: SOS node view and rescue dashboard.",
  "start_url": "/node",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#9b1c1c",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "SOS node view", "url": "/node" },
    { "name": "Rescue dashboard", "url": "/rescue" }
  ]
}
